-- VS Code Shortcuts --

ctrl + w                    # Close Current Tab / Close editor

ctrl + <number>             # Move betwen Editing Window
ctrl + pageUp               # Move to the Left Tab
ctrl + pageDown             # Move to the Right Tab

ctrl + shift + <arrowKey>   # Move tab to adjacent editing group
ctrl + alt + <arrowKey>     # Move Current Tab to new Slipt Window on a certain direction

ctrl + \                    # Split Tab

ctrl + b                    # Toggle SideBar
ctrl + `                    # Toggle Bottom Terminal

ctrl + shift + e            # Move focus to file Explorer SideBar (press enter on file to open)
ctrl + shift + f            # Move Focus to Find SideBar
ctrl + shift + g            # Move Focus to Version Control SideBar
ctrl + shift + d            # Move Focus to Run and Debug SideBar
ctrl + shift + x            # Move Focus to Extensions SideBar

ctrl + shift + p            # Open Command
ctrl + ,                    # Open Settings Tab
