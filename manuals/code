-- VS Code Shortcuts --

ctrl + w                    # Close Current Tab / Close editor

ctrl + <number>             # Move betwen Editing Window
ctrl + pageUp/pageDown      # Move to the Previous/Next Tab or Terminal
ctrl + shift + pageUp       # Move Current Tab to the Left
ctrl + shift + pageDown     # Move Current Tab to the Right

ctrl + shift + <arrowKey>   # Move tab to adjacent editing group
ctrl + alt + <arrowKey>     # Move Current Tab to new Split Window on a certain direction

ctrl + \                    # Split Tab

ctrl + `                    # Toggle Bottom Terminal
ctrl + shift + `            # Create new Terminal

ctrl + b                    # Toggle SideBar
ctrl + shift + e            # Move focus to file Explorer SideBar (press enter on file to open)
ctrl + shift + f            # Move Focus to Find SideBar
ctrl + shift + g            # Move Focus to Version Control SideBar
ctrl + shift + d            # Move Focus to Run and Debug SideBar
ctrl + shift + x            # Move Focus to Extensions SideBar

ctrl + shift + p            # Open Command
ctrl + ,                    # Open Settings Tab

# To Open New File in File Explorer:
- ctrl + shift + e 
- Go to desired Path
- ctrl + shift + p
- type 'File: New Untitled Text File'
- ctrl + s
- save with name + file extension

# To Open New Folder in File Explorer:
- ctrl + shift + e 
- Go to desired Path
- ctrl + shift + p
- type 'File: New Folder...'
- type in name of Folder
- press Enter1